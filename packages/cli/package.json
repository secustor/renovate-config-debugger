{
  "name": "@renovate-config-debugger/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental — headless Renovate config debugger: preset tree, provenance, packageRules simulator and validation, as structured data",
  "bin": {
    "rcd": "./bin/rcd.mjs"
  },
  "type": "module",
  "scripts": {
    "rcd": "node ./bin/rcd.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@renovate-config-debugger/app": "workspace:*",
    "@renovate-config-debugger/engine": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
