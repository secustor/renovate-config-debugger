      "datasource": "docker"
    },
    {
      "depName": "https://github.com/batect/hello-world-bundle.git",
      "currentValue": "1.0.0",
      "versioning": "semver",
      "datasource": "git-tags",
      "commitMessageTopic": "bundle {{depName}}"
    }
  ]
}