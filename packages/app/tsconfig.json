{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@tools/*": ["../../tools/*"],
      // Same file the package's `exports` points at — `tools/` sits outside
      // any `node_modules` that could resolve the workspace link.
      "@renovate-config-debugger/engine": ["../engine/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "../engine/src/types/renovate-dist.d.ts"]
}
