{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The react plugin carries the hooks rules (namespaced `react/` in oxlint).
  // Enabling a plugin activates its `correctness`/`suspicious` rules too, so
  // `import` and `promise` are here for the rules named below PLUS whatever
  // those two categories cover — which since roadmap 041 is an error.
  "plugins": ["unicorn", "typescript", "oxc", "react", "import", "promise"],
  // Roadmap 041: `suspicious` was the last thing configured at warn. Nothing is
  // advisory any more — `pnpm lint` reporting anything at all fails CI, which is
  // the point: an oxlint upgrade that adds rules to a category gets a decision
  // at upgrade time (an explicit renovate PR) instead of drifting silently.
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  // `public/` is copied into the bundle verbatim — it is deployment payload,
  // not app source (roadmap 043's `rcv-config.js` stub is a comment and
  // nothing else, by design).
  "ignorePatterns": ["dist", "coverage", "node_modules", "packages/app/public"],
  "rules": {
    // Only rules the categories above do NOT already cover are listed here
    // (roadmap 041 dropped `react/jsx-key` + `react/exhaustive-deps`, which
    // `correctness` carries, and `promise/always-return`, which `suspicious`
    // does — all three are still enforced at error, just not twice).
    //
    // Automatic JSX runtime (@vitejs/plugin-react) — React is never in scope.
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/jsx-no-target-blank": "error",
    // Fast Refresh only replaces a module that exports components and nothing
    // else; a stray helper export silently turns edits into full reloads.
    "react/only-export-components": "error",
    "react/jsx-no-useless-fragment": "error",
    // Roadmap 040: JSX depth is a decomposition driver with a measurable exit
    // criterion — the rule counts nesting within ONE JSX expression, so an
    // extraction resets the counter at the component boundary. Ratcheted down
    // over four commits (6 → 5 → 4 → 3); the step to 3 is roadmap 048's exit
    // criterion, met once 048 decomposed the four remaining depth-4 files
    // (RuleSimulator, App, EffectiveConfig, AdvancedZone).
    // (oxlint spells the option `max`, not eslint-plugin-react's `maxDepth`.)
    "react/jsx-max-depth": ["error", { "max": 3 }],
    // Roadmap 034 parked these two at warn behind a 141-hit backlog; roadmap
    // 041 cleared the backlog and promoted them. The handful of sites where the
    // index/assertion really is the honest answer carry an inline disable that
    // states the invariant, so there is no tier left for a hit to hide in.
    "react/no-array-index-key": "error",
    "typescript/no-non-null-assertion": "error",
    // Named exports keep re-exports and IDE rename working; the tool-mandated
    // default exports are listed in the overrides below.
    "import/no-default-export": "error",
    // Side-effect imports are how CSS is pulled in under Vite — not a smell.
    // The allow-list says exactly that, so a future NON-CSS side-effect import
    // is an error instead of being invisible (roadmap 038: measured 0 hits).
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/no-array-for-each": "error",
    // Roadmap 043: the `__RCV_*__` globals are the injected deployment config —
    // the dangling underscores are the convention that says "written by a
    // deployment, not by this codebase". Everything else keeps the rule.
    "no-underscore-dangle": ["error", { "allow": ["__RCV_OAUTH__", "__RCV_ANALYTICS__"] }],

    // --- Type-aware tier (needs `--type-aware` + oxlint-tsgolint) -----------
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-deprecated": "error",
    // A `default` arm counts as exhaustive: this codebase uses catch-all
    // defaults deliberately, and the bug this rule is here to catch — a new
    // union member silently falling through a switch with NO default — is
    // still caught.
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],

    // Type-aware rules that `--type-aware` brings along and that roadmap 034
    // evaluated but did NOT adopt — their 1.75 violation counts and the
    // reasoning are recorded in roadmap/034-lint-hardening.md. Listed
    // explicitly so "off" reads as a decision, not an oversight.
    "typescript/no-unnecessary-condition": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-type-parameters": "off",

    // Roadmap 038: the three type-aware rules whose whole cost was one site
    // each — enabled, with that single site fixed or disabled in place.
    "typescript/unbound-method": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unnecessary-template-expression": "error"
  },
  "overrides": [
    {
      // Tool-mandated default exports: each of these files is loaded by name by
      // vite/vitest/playwright or by the Workers runtime, all of which read the
      // default export and nothing else.
      "files": [
        "packages/*/vite.config.ts",
        "packages/*/vitest.config.ts",
        "packages/*/playwright.config.ts",
        "packages/oauth-worker/src/index.ts",
        "stylelint.config.mjs"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      // The renovate/dist import boundary (previously a grep step in ci.yml).
      // Renovate has no public API, so every deep import is a private-file
      // dependency a version bump can break — they are confined to the adapter,
      // the browser shims and the ambient declarations so a bump has exactly one
      // place to look. The Node tests that deliberately compare against the real
      // modules live outside `src/`, so they are unaffected — same scope as the
      // grep this replaces.
      "files": ["packages/engine/src/**", "packages/app/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              }
            ]
          }
        ]
      }
    },
    {
      // …and the three places that ARE allowed to reach into renovate/dist.
      "files": [
        "packages/engine/src/renovate-adapter.ts",
        "packages/engine/src/shims/**",
        "packages/engine/src/types/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    // ---- Roadmap 048: two single-import-site invariants ------------------
    // Until now these were comment-only: the header comments on
    // input-schemas-zod.ts and editor-schema.ts *said* "only this module may
    // import X" but nothing enforced it. Mechanized the same way as the
    // renovate/dist boundary above — a named group per forbidden specifier,
    // with the one designated file exempted in its own override further down
    // (oxlint overrides REPLACE, so that exemption must restate everything
    // else that still applies to it).
    //
    // Scoped to `packages/app/src/**` only (not the engine package): neither
    // specifier is imported from engine/src today (measured — zero hits), and
    // the invariant as written ("packages/app/src/…") is app-side by design.
    {
      "files": ["packages/app/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                // "zod" itself is included alongside "zod/**": the module's
                // own header comment requires every import to come from the
                // "zod/mini" subpath specifically, but the group here only
                // needs to catch "an import of the zod package from the
                // wrong file" — the full-vs-mini choice is enforced by
                // review, not lintable via a specifier group.
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    },
    // ---- Roadmap 048: the layer boundary ---------------------------------
    // §2 of the structure research (2026-07-vite-structure-research.md) is a
    // unidirectional flow, `app → features → shared`: the app shell composes
    // features, features are built out of the shared layer, and neither of the
    // lower two ever reaches back up. The two overrides below are that rule,
    // mechanized — the arrows are otherwise invisible until an import has
    // already welded two things together.
    //
    // All four restate the renovate/dist group, plus the zod/schema-stack
    // groups from the override above: oxlint overrides REPLACE a rule's
    // options rather than merging them (measured), so an override that listed
    // only its own patterns would silently switch every OTHER boundary off
    // for every file it matched.
    {
      // The shared layer. Reaching DOWN into a feature inverts the flow and
      // makes the two inseparable; the fix is always to hoist the composition
      // into the app shell (`packages/app/src/*.tsx` — App.tsx and siblings),
      // which is exactly why ResultsColumn.tsx lives there.
      //
      // Roadmap 048 follow-up: this used to enumerate the five shared folders
      // by name (components/hooks/lib/data/platform), which meant a future
      // `src/utils/` (or stores/, types/, styles/, api/ — all plausible next
      // additions) would silently sit OUTSIDE the boundary until someone
      // remembered to add it here. Inverted to "everything under src/ that
      // isn't a feature or the app shell" so shared is the default, not an
      // allow-list — measured via excludeFiles (confirmed against
      // configuration_schema.json: `OxlintOverride.excludeFiles` takes a
      // GlobSet of paths this override does NOT apply to, verified empirically
      // that it works as documented). `packages/app/src/*.tsx` excludes
      // exactly the app-shell files (App.tsx and siblings, plus main.tsx and
      // the root-level test file) because `*` does not cross `/` — confirmed
      // empirically it does not also swallow `components/ConfigEditor.tsx`.
      "files": ["packages/app/src/**"],
      "excludeFiles": ["packages/app/src/features/**", "packages/app/src/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                // The `**/features/**` variants are belt-and-braces: the `@/`
                // alias is the only spelling in use today, but a `../` escape
                // out of a nested folder would resolve just as well.
                "group": [
                  "@/features",
                  "@/features/*",
                  "@/features/**",
                  "**/features/*",
                  "**/features/**"
                ],
                "message": "Shared modules must not import a feature — compose features at the app level (roadmap 048)."
              },
              {
                // Closes the upward arrow: nothing previously forbade shared
                // modules from reaching UP into the app shell. `@/*` matches
                // `@/App` but not `@/components/glossary` (confirmed
                // empirically — minimatch `*` does not cross `/`); the three
                // `../` variants cover every nesting depth actually present
                // under the shared folders today (all are one level below
                // `src/`, so `../*` alone would suffice, but the extra two
                // are cheap insurance against a future subfolder) without
                // catching a legal same-folder `./x` or a legal
                // shared-to-shared `../lib/foo` (measured: zero existing `../`
                // imports anywhere in the shared or feature layers today, so
                // this starts and stays at zero hits).
                "group": ["@/*", "../*", "../../*", "../../../*"],
                "message": "Shared modules must not import the app shell — compose downward: the app shell composes features, features compose the shared layer (roadmap 048)."
              },
              {
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    },
    {
      // Feature slices. A feature imports its own files relatively (`./`) and
      // everything else from the shared layer; the same pattern that forbids
      // shared → feature therefore forbids feature → OTHER feature, which is
      // what keeps a slice extractable.
      "files": ["packages/app/src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                "group": [
                  "@/features",
                  "@/features/*",
                  "@/features/**",
                  "**/features/*",
                  "**/features/**"
                ],
                "message": "No cross-feature imports — inside a feature import relatively (`./`); features are composed at the app level (roadmap 048)."
              },
              {
                // Same upward-arrow closure as the shared-layer override
                // above, restated per the REPLACE rule. `features/simulator/`
                // is one folder deeper than the shared layer's folders, so
                // `../../*` (not just `../*`) is the one that actually
                // matters here — reaching `src/App` from
                // `features/simulator/*.ts` takes two `../` hops.
                "group": ["@/*", "../*", "../../*", "../../../*"],
                "message": "Features must not import the app shell — compose downward: the app shell composes features (roadmap 048)."
              },
              {
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    },
    // ---- Roadmap 048: the two single-import-site exemptions ---------------
    // One override per file, not one override for both: input-schemas-zod.ts
    // is the designated zod site but is NOT the designated schema-stack site
    // (and vice versa for editor-schema.ts), so each exemption restates the
    // OTHER file's ban alongside the shared-layer boundary (both files live
    // under a shared folder — lib/ and platform/ respectively) plus the
    // renovate/dist group. Placed last so they win per the REPLACE/last-match
    // rule (confirmed empirically against a throwaway config: when two
    // overrides in the array match the same file, the LAST one's rule value
    // is what applies, not a merge of both).
    {
      "files": ["packages/app/src/lib/input-schemas-zod.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                "group": ["@/*", "../*", "../../*", "../../../*"],
                "message": "Shared modules must not import the app shell — compose downward: the app shell composes features, features compose the shared layer (roadmap 048)."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/app/src/platform/editor-schema.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                "group": ["@/*", "../*", "../../*", "../../../*"],
                "message": "Shared modules must not import the app shell — compose downward: the app shell composes features, features compose the shared layer (roadmap 048)."
              },
              {
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              }
            ]
          }
        ]
      }
    }
  ]
}
