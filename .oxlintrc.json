{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The react plugin carries the hooks rules (namespaced `react/` in oxlint).
  // Enabling a plugin activates its `correctness`/`suspicious` rules too, so
  // `import` and `promise` are here for the rules named below PLUS whatever
  // those two categories cover — which since roadmap 041 is an error.
  //
  // `unicorn`, `typescript` and `oxc` are on by default (`oxlint --help`, the
  // "Enable/Disable Plugins" section, labels those three); they stay listed as
  // a pin, so a future oxlint that changes its defaults does not quietly
  // shrink this repo's rule set.
  //
  // `react-perf` and `node` were added after auditing the full plugin list
  // against this repo's shape. Both measured ZERO violations at the
  // correctness+suspicious tier, so neither costs a backlog, and both are
  // on-topic: a React 19 SPA, and a Node CLI plus the oauth-worker's Node image
  // target. Skipped deliberately: `jest` (wrong runner — its hits are a subset
  // of `vitest`'s, matched by name), and `jsdoc`/`nextjs`/`vue` (nothing in
  // this codebase to check, 0 hits each).
  //
  // NOT yet added, both real and both costed:
  //   `vitest`   — squarely on target, every test here is vitest, but 241
  //                violations. 69 of them are test-CORRECTNESS bugs worth
  //                fixing on their own (no-conditional-expect, valid-expect,
  //                expect-expect, no-standalone-expect); the other 149 are the
  //                mechanical `vi.fn()` → `vi.fn<Sig>()` migration. Wants its
  //                own roadmap entry, fixed first and enabled after, because
  //                the zero-tolerance policy leaves no warn tier to park it in.
  //   `jsx-a11y` — 22 violations, each a plausible real gap (focus management,
  //                missing labels, role/tag mismatches). Tractable, but it is
  //                an accessibility commitment this repo has not made
  //                explicitly, so it is a decision rather than a cleanup.
  "plugins": ["unicorn", "typescript", "oxc", "react", "react-perf", "import", "promise", "node"],
  // Roadmap 041: `suspicious` was the last thing configured at warn. Nothing is
  // advisory any more — `pnpm lint` reporting anything at all fails CI, which is
  // the point: an oxlint upgrade that adds rules to a category gets a decision
  // at upgrade time (an explicit renovate PR) instead of drifting silently.
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  // `public/` is copied into the bundle verbatim — it is deployment payload,
  // not app source (roadmap 043's `rcd-config.js` stub is a comment and
  // nothing else, by design).
  "ignorePatterns": ["dist", "coverage", "node_modules", "packages/app/public"],
  "rules": {
    // Only rules the categories above do NOT already cover are listed here
    // (roadmap 041 dropped `react/jsx-key` + `react/exhaustive-deps`, which
    // `correctness` carries, and `promise/always-return`, which `suspicious`
    // does — all three are still enforced at error, just not twice).
    //
    // Automatic JSX runtime (@vitejs/plugin-react) — React is never in scope.
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/jsx-no-target-blank": "error",
    // Fast Refresh only replaces a module that exports components and nothing
    // else; a stray helper export silently turns edits into full reloads.
    "react/only-export-components": "error",
    "react/jsx-no-useless-fragment": "error",
    // Roadmap 040: JSX depth is a decomposition driver with a measurable exit
    // criterion — the rule counts nesting within ONE JSX expression, so an
    // extraction resets the counter at the component boundary. Ratcheted down
    // over four commits (6 → 5 → 4 → 3); the step to 3 is roadmap 048's exit
    // criterion, met once 048 decomposed the four remaining depth-4 files
    // (RuleSimulator, App, EffectiveConfig, AdvancedZone).
    // (oxlint spells the option `max`, not eslint-plugin-react's `maxDepth`.)
    "react/jsx-max-depth": ["error", { "max": 3 }],
    // Roadmap 034 parked these two at warn behind a 141-hit backlog; roadmap
    // 041 cleared the backlog and promoted them. The handful of sites where the
    // index/assertion really is the honest answer carry an inline disable that
    // states the invariant, so there is no tier left for a hit to hide in.
    "react/no-array-index-key": "error",
    "typescript/no-non-null-assertion": "error",
    // Named exports keep re-exports and IDE rename working; the tool-mandated
    // default exports are listed in the overrides below.
    "import/no-default-export": "error",
    // Side-effect imports are how CSS is pulled in under Vite — not a smell.
    // The allow-list says exactly that, so a future NON-CSS side-effect import
    // is an error instead of being invisible (roadmap 038: measured 0 hits).
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/no-array-for-each": "error",
    // Roadmap 043: the `__RCD_*__` globals are the injected deployment config —
    // the dangling underscores are the convention that says "written by a
    // deployment, not by this codebase". Everything else keeps the rule.
    "no-underscore-dangle": ["error", { "allow": ["__RCD_OAUTH__", "__RCD_ANALYTICS__"] }],

    // --- Type-aware tier (needs `--type-aware` + oxlint-tsgolint) -----------
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-deprecated": "error",
    // A `default` arm counts as exhaustive: this codebase uses catch-all
    // defaults deliberately, and the bug this rule is here to catch — a new
    // union member silently falling through a switch with NO default — is
    // still caught.
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],

    // Type-aware rules that `--type-aware` brings along and that roadmap 034
    // evaluated but did NOT adopt — their 1.75 violation counts and the
    // reasoning are recorded in roadmap/034-lint-hardening.md. Listed
    // explicitly so "off" reads as a decision, not an oversight.
    "typescript/no-unnecessary-condition": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-type-parameters": "off",

    // Roadmap 038: the three type-aware rules whose whole cost was one site
    // each — enabled, with that single site fixed or disabled in place.
    "typescript/unbound-method": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unnecessary-template-expression": "error"
  },
  "overrides": [
    {
      // Tool-mandated default exports: each of these files is loaded by name by
      // vite/vitest/playwright or by the Workers runtime, all of which read the
      // default export and nothing else.
      "files": [
        "packages/*/vite.config.ts",
        "packages/*/vitest.config.ts",
        "packages/*/playwright.config.ts",
        "packages/oauth-worker/src/index.ts",
        "stylelint.config.mjs",
        "release.config.mjs"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      // The renovate/dist import boundary (previously a grep step in ci.yml).
      // Renovate has no public API, so every deep import is a private-file
      // dependency a version bump can break — they are confined to the adapter,
      // the shims' own ledger and the ambient declarations so a bump has exactly
      // one place to look. The Node tests that deliberately compare against the
      // real modules live outside `src/`, so they are unaffected — same scope as
      // the grep this replaces.
      "files": ["packages/engine/src/**", "packages/app/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/renovate-internals.ts or types/ — go through one of those instead."
              }
            ]
          }
        ]
      }
    },
    {
      // …and the three places that ARE allowed to reach into renovate/dist.
      // The shims cannot use the adapter (it re-exports config/presets/index.js,
      // whose per-host children the preset shims replace — that is an import
      // cycle), so they get their own ledger; naming the ONE file here, rather
      // than all of shims/**, is what keeps that surface a ledger.
      "files": [
        "packages/engine/src/renovate-adapter.ts",
        "packages/engine/src/shims/renovate-internals.ts",
        "packages/engine/src/types/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    // ---- Roadmap 048: two single-import-site invariants ------------------
    // Until now these were comment-only: the header comments on
    // input-schemas-zod.ts and editor-schema.ts *said* "only this module may
    // import X" but nothing enforced it. Mechanized the same way as the
    // renovate/dist boundary above — a named group per forbidden specifier,
    // with the one designated file exempted in its own override further down
    // (oxlint overrides REPLACE, so that exemption must restate everything
    // else that still applies to it).
    //
    // Scoped to `packages/app/src/**` only (not the engine package): neither
    // specifier is imported from engine/src today (measured — zero hits), and
    // the invariant as written ("packages/app/src/…") is app-side by design.
    {
      "files": ["packages/app/src/**"],
      "rules": {
        // Roadmap 048 follow-up (structure review, finding 6): the relative
        // escape hatch, closed depth-independently.
        //
        // The layer bans below are SPECIFIER-based, so they only catch a
        // spelling they can name. From `features/simulator/X.ts` the cross-
        // feature ban catches `@/features/presets/rows` (alias) and
        // `../../features/presets/rows` (has a `features` segment), but NOT
        // `../presets/rows` — three segments, so the `../*` patterns miss it
        // (minimatch `*` does not cross `/`), and no `features` segment, so
        // `**/features/**` misses it too. That is exactly the spelling an
        // editor's auto-import emits.
        //
        // This rule bans reaching out of a folder at all, so the whole class is
        // closed at every depth. It is also a DISTINCT rule key, which is why
        // it belongs here rather than in a pattern bank: the REPLACE semantics
        // that dropped a group in the two exemption overrides below cannot
        // touch it, and one declaration covers every file under app/src.
        // Measured at zero hits — this codebase already imports its own layer
        // relatively (`./`) and everything else through `@/`.
        "import/no-relative-parent-imports": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                // Structure review, finding 4. `platform/engine-chunk.ts` states
                // that the ~437 kB gz Renovate graph is reached only through
                // `loadEngine()`; a static VALUE import of the root barrel
                // silently breaks that, and one had — `lib/rule-verdict.ts`
                // re-exported two predicates from the root, welding the whole
                // graph onto `ResultsColumn`'s static chunk via
                // `ResultsColumn → TestsPanel → rule-filters → rule-verdict`.
                //
                // Types are free (erased before a bundler sees them), and they
                // are how the app names the engine's shapes in ~150 files —
                // hence `allowTypeImports`. Runtime access goes through the
                // narrow subpaths (`/text-scan`, `/schema`,
                // `/simulate-missing-inputs`) or through `loadEngine()`.
                "group": ["@renovate-config-debugger/engine"],
                "allowTypeImports": true,
                "message": "Value-importing the engine ROOT statically pulls the whole Renovate graph into this chunk — use a narrow subpath export, or load it at runtime through platform/engine-chunk.ts (`loadEngine()`). Type-only imports are fine."
              },
              {
                // "zod" itself is included alongside "zod/**": the module's
                // own header comment requires every import to come from the
                // "zod/mini" subpath specifically, but the group here only
                // needs to catch "an import of the zod package from the
                // wrong file" — the full-vs-mini choice is enforced by
                // review, not lintable via a specifier group.
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    },
    // ---- Roadmap 048: the layer boundary ---------------------------------
    // §2 of the structure research (2026-07-vite-structure-research.md) is a
    // unidirectional flow, `app → features → shared`: the app shell composes
    // features, features are built out of the shared layer, and neither of the
    // lower two ever reaches back up. The two overrides below are that rule,
    // mechanized — the arrows are otherwise invisible until an import has
    // already welded two things together.
    //
    // All four restate the renovate/dist group, plus the zod/schema-stack
    // groups from the override above: oxlint overrides REPLACE a rule's
    // options rather than merging them (measured), so an override that listed
    // only its own patterns would silently switch every OTHER boundary off
    // for every file it matched.
    {
      // The shared layer. Reaching DOWN into a feature inverts the flow and
      // makes the two inseparable; the fix is always to hoist the composition
      // into the app shell (`packages/app/src/app/**` — App.tsx and its
      // siblings), which is exactly why ResultsColumn.tsx lives there.
      //
      // Roadmap 048 follow-up: this used to enumerate the five shared folders
      // by name (components/hooks/lib/data/platform), which meant a future
      // `src/utils/` (or stores/, types/, styles/, api/ — all plausible next
      // additions) would silently sit OUTSIDE the boundary until someone
      // remembered to add it here. Inverted to "everything under src/ that
      // isn't a feature or the app shell" so shared is the default, not an
      // allow-list — measured via excludeFiles (confirmed against
      // configuration_schema.json: `OxlintOverride.excludeFiles` takes a
      // GlobSet of paths this override does NOT apply to, verified empirically
      // that it works as documented).
      //
      // The shell used to be loose files at `src/` root, excluded by
      // `packages/app/src/*.tsx` (`*` does not cross `/`, so it caught exactly
      // App.tsx and its siblings and nothing under `components/`). It now has
      // a folder of its own, so the exclusion is the folder — which also
      // covers the shell-only hooks that moved in with it (use-repo-load,
      // use-inherited-config-layer, use-focus-landing, use-run-summary,
      // use-tab-digits) and no longer depends on a glob subtlety to stay
      // narrow. `main.tsx` stays at `src/` root because it is Vite's HTML
      // entry, so it is named separately rather than losing the shell status
      // the old glob gave it.
      "files": ["packages/app/src/**"],
      "excludeFiles": [
        "packages/app/src/features/**",
        "packages/app/src/app/**",
        "packages/app/src/main.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                // Structure review, finding 4 — restated per the REPLACE rule;
                // the reasoning is on the first copy, in the override above.
                "group": ["@renovate-config-debugger/engine"],
                "allowTypeImports": true,
                "message": "Value-importing the engine ROOT statically pulls the whole Renovate graph into this chunk — use a narrow subpath export, or load it at runtime through platform/engine-chunk.ts (`loadEngine()`). Type-only imports are fine."
              },
              {
                // The `**/features/**` variants are belt-and-braces: the `@/`
                // alias is the only spelling in use today, but a `../` escape
                // out of a nested folder would resolve just as well.
                "group": [
                  "@/features",
                  "@/features/*",
                  "@/features/**",
                  "**/features/*",
                  "**/features/**"
                ],
                "message": "Shared modules must not import a feature — compose features at the app level (roadmap 048)."
              },
              {
                // Closes the upward arrow: nothing previously forbade shared
                // modules from reaching UP into the app shell. `@/*` matches
                // a bare `@/App` but not `@/components/glossary` (confirmed
                // empirically — minimatch `*` does not cross `/`).
                //
                // The shell now lives in `src/app/`, one segment further down,
                // which `*` by definition cannot reach — so the `@/app…`
                // spellings are listed explicitly. Without them the upward
                // arrow would have quietly reopened the moment the shell got a
                // folder. `@/app/**` is safe to ban outright because no shared
                // or feature module may name the shell at all; the shell itself
                // is excluded from this override.
                //
                // This group used to carry nine `../…` spellings alongside the
                // alias ones. `import/no-relative-parent-imports` (declared once
                // in the app-wide override at the top) now bans reaching out of
                // a folder AT ALL, at every depth, so enumerating escape depths
                // here is both redundant and — as finding 6 showed — incomplete:
                // `../presets/rows` matched none of them.
                "group": ["@/*", "@/app", "@/app/*", "@/app/**"],
                "message": "Shared modules must not import the app shell — compose downward: the app shell composes features, features compose the shared layer (roadmap 048)."
              },
              {
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    },
    {
      // Feature slices. A feature imports its own files relatively (`./`) and
      // everything else from the shared layer; the same pattern that forbids
      // shared → feature therefore forbids feature → OTHER feature, which is
      // what keeps a slice extractable.
      "files": ["packages/app/src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                "group": [
                  "@/features",
                  "@/features/*",
                  "@/features/**",
                  "**/features/*",
                  "**/features/**"
                ],
                "message": "No cross-feature imports — inside a feature import relatively (`./`); features are composed at the app level (roadmap 048)."
              },
              {
                // Structure review, finding 4 — restated per the REPLACE rule;
                // the reasoning is on the first copy, two overrides above.
                "group": ["@renovate-config-debugger/engine"],
                "allowTypeImports": true,
                "message": "Value-importing the engine ROOT statically pulls the whole Renovate graph into this chunk — use a narrow subpath export, or load it at runtime through platform/engine-chunk.ts (`loadEngine()`). Type-only imports are fine."
              },
              {
                // Same upward-arrow closure as the shared-layer override
                // above, restated per the REPLACE rule. The depth that used to
                // matter here — `features/simulator/` is one folder deeper than
                // the shared layer's folders, so reaching `src/app/App` takes
                // two `../` hops — is no longer this group's problem:
                // `import/no-relative-parent-imports` is depth-independent.
                "group": ["@/*", "@/app", "@/app/*", "@/app/**"],
                "message": "Features must not import the app shell — compose downward: the app shell composes features (roadmap 048)."
              },
              {
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    },
    // ---- Roadmap 048: the three single-import-site exemptions -------------
    // One override per file, not one override for all three: input-schemas-zod
    // is the designated zod site but is NOT the designated schema-stack site
    // (and vice versa for editor-schema.ts), so each exemption restates the
    // OTHER files' bans alongside the shared-layer boundary (all three live
    // under a shared folder — lib/ and platform/) plus the renovate/dist group.
    // Placed last so they win per the REPLACE/last-match rule (confirmed
    // empirically against a throwaway config: when two overrides in the array
    // match the same file, the LAST one's rule value is what applies, not a
    // merge of both).
    //
    // engine-chunk.ts joined the family with the structure review's finding 4:
    // it is the designated site for the engine ROOT, exactly as the other two
    // are for zod and the schema stack. Its `loadEngine()` is a DYNAMIC import,
    // which oxlint's no-restricted-imports does see (measured against a
    // throwaway probe — so `await import(…)` is not the escape hatch finding 8
    // asked about, in either direction: it cannot smuggle a banned specifier
    // past the rule, and it cannot escape one either).
    {
      "files": ["packages/app/src/lib/input-schemas-zod.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                "group": ["@/*", "@/app", "@/app/*", "@/app/**"],
                "message": "Shared modules must not import the app shell — compose downward: the app shell composes features, features compose the shared layer (roadmap 048)."
              },
              {
                // Structure review, finding 5: this group was MISSING here and
                // in the override below. Both files are shared-layer and both
                // are last-match, so for those two files the shared → feature
                // ban was simply absent — the REPLACE semantics eating a
                // boundary nobody noticed was gone. Zero hits either way; the
                // point is that the rule now exists to have zero hits of.
                "group": [
                  "@/features",
                  "@/features/*",
                  "@/features/**",
                  "**/features/*",
                  "**/features/**"
                ],
                "message": "Shared modules must not import a feature — compose features at the app level (roadmap 048)."
              },
              {
                // Structure review, finding 4 — restated per the REPLACE rule.
                "group": ["@renovate-config-debugger/engine"],
                "allowTypeImports": true,
                "message": "Value-importing the engine ROOT statically pulls the whole Renovate graph into this chunk — use a narrow subpath export, or load it at runtime through platform/engine-chunk.ts (`loadEngine()`). Type-only imports are fine."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/app/src/platform/editor-schema.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                "group": ["@/*", "@/app", "@/app/*", "@/app/**"],
                "message": "Shared modules must not import the app shell — compose downward: the app shell composes features, features compose the shared layer (roadmap 048)."
              },
              {
                // Structure review, finding 5 — see the note on the copy in the
                // override above; this file was the other half of that gap.
                "group": [
                  "@/features",
                  "@/features/*",
                  "@/features/**",
                  "**/features/*",
                  "**/features/**"
                ],
                "message": "Shared modules must not import a feature — compose features at the app level (roadmap 048)."
              },
              {
                // Structure review, finding 4 — restated per the REPLACE rule.
                "group": ["@renovate-config-debugger/engine"],
                "allowTypeImports": true,
                "message": "Value-importing the engine ROOT statically pulls the whole Renovate graph into this chunk — use a narrow subpath export, or load it at runtime through platform/engine-chunk.ts (`loadEngine()`). Type-only imports are fine."
              },
              {
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              }
            ]
          }
        ]
      }
    },
    {
      // The engine root's one legal site: `loadEngine()`'s dynamic import is
      // the seam the whole lazy-loading design rests on. Everything EXCEPT the
      // engine-root group is restated, per REPLACE.
      "files": ["packages/app/src/platform/engine-chunk.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                "group": [
                  "@/features",
                  "@/features/*",
                  "@/features/**",
                  "**/features/*",
                  "**/features/**"
                ],
                "message": "Shared modules must not import a feature — compose features at the app level (roadmap 048)."
              },
              {
                "group": ["@/*", "@/app", "@/app/*", "@/app/**"],
                "message": "Shared modules must not import the app shell — compose downward: the app shell composes features, features compose the shared layer (roadmap 048)."
              },
              {
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    },
    // ---- Structure review, finding 4: the engine-root exemption -------------
    // The shimmed component tests drive the REAL pipeline — `runPipeline` and
    // friends off the root barrel is the whole point of the `shimmed` vitest
    // project, and there is no narrower subpath that could serve them. They are
    // also not production code, and the ban they are exempt from is a
    // chunk-hygiene rule about what ships.
    //
    // Placed last so it wins per the REPLACE/last-match rule, and restating
    // every other group for the same reason — these files live under both the
    // shared layer (components/) and the feature layer (features/), whose two
    // banks differ only in the WORDING of the features message, not its
    // patterns. `packages/app/src/vitest-projects.test.ts` pins the filename
    // convention this glob relies on, and the config-sync test pins the
    // restatement.
    //
    // The SHELL's shimmed test is excluded rather than covered: it composes
    // five feature panels (that is what it tests) and is legally allowed to,
    // being shell — so the cross-slice ban below must not reach it. It does not
    // value-import the engine root, so it needs no exemption; excluding it
    // leaves it on the app-wide bank, engine ban included.
    {
      "files": ["packages/app/src/**/*.shimmed.test.tsx"],
      "excludeFiles": ["packages/app/src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["renovate/dist", "renovate/dist/**"],
                "message": "Deep renovate/dist imports belong in renovate-adapter.ts, shims/ or types/ — go through the adapter instead."
              },
              {
                "group": [
                  "@/features",
                  "@/features/*",
                  "@/features/**",
                  "**/features/*",
                  "**/features/**"
                ],
                "message": "A test may drive the engine, but not reach across slices — import the slice under test relatively (`./`), the way its own modules do (roadmap 048)."
              },
              {
                "group": ["@/*", "@/app", "@/app/*", "@/app/**"],
                "message": "Tests of a feature or shared module must not import the app shell — the shell's own tests live beside it (roadmap 048)."
              },
              {
                "group": ["zod", "zod/**"],
                "message": "zod may only be imported statically from lib/input-schemas-zod.ts (via zod/mini) — a static import anywhere else pulls the zod chunk back into the entry bundle (roadmap 030/031)."
              },
              {
                "group": [
                  "codemirror-json-schema",
                  "codemirror-json-schema/**",
                  "@renovate-config-debugger/engine/schema",
                  "@renovate-config-debugger/engine/schema/**"
                ],
                "message": "codemirror-json-schema and the engine's schema export may only be imported statically from platform/editor-schema.ts — that's the one place the ~160 kB gz schema stack is allowed into a chunk (roadmap 031)."
              }
            ]
          }
        ]
      }
    }
  ]
}
